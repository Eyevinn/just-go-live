# Copy to .env and fill in. .env is gitignored.
#
# Prefer this over `export OSC_ACCESS_TOKEN=...` on the command line, which
# leaves the token in your shell history.

# Required. Your Open Source Cloud access token. It controls the account this
# app creates encoder instances on, so treat it as a credential.
OSC_ACCESS_TOKEN=

# Optional. Public base URL used to build viewer links.
# PUBLIC_URL=https://live.example.com

# Optional. Defaults to 3000.
# PORT=3000

# Optional. Where streams.json is written. Defaults to the application
# directory in development and /userdata in production.
# DATA_DIR=/userdata
